BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
ADMIN_IDS=123456789
LOG_LEVEL=INFO
TZ_DEFAULT=Europe/Moscow
OZON_STRATEGY=http            # http — идентичность браузера + curl_cffi; headless — fetch из вкладки; api — платный parser-API
OZON_RPS=0.5
OZON_PROXY_URL=               # опционально; без него env-прокси запрещены
OZON_API_KEY=                 # только для strategy=api
OZON_TIMEOUT_SECONDS=20
OZON_MAX_ATTEMPTS=3
# Идентичность антибота Ozon (cookie abt_data + UA браузера, прошедшего challenge).
# Пусто = добывать браузером на этом же хосте (нужен extra [browser] и Chromium).
# Заполнено = брать готовую идентичность; ОБЯЗАТЕЛЬНО тот же egress-IP, где она получена.
OZON_COOKIE=
OZON_USER_AGENT=
OZON_IDENTITY_TTL_SECONDS=43200
OZON_PROFILE_DIR=.ozon-profile
OZON_BROWSER_HEADLESS=true
OZON_BROWSER_MAC_DISGUISE=true
FREE_TRACK_LIMIT=3
PLUS_TRACK_LIMIT=20
PRO_TRACK_LIMIT=100
PLUS_STARS=100
PRO_STARS=270
QUIET_FROM=22
QUIET_TO=9
FEATURE_WB=false 
